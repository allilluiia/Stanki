VITE_BASE=/

# Public site URL (used in legal documents)
# VITE_SITE_URL=https://example.com

# Mail endpoint (production PHP host or separate API)
# VITE_MAIL_URL=https://example.com/send-mail.php

# Demo form mode for static hosts / GitHub Pages (no PHP)
# VITE_PAGES_PREVIEW=true
# VITE_FORM_DEMO=true

# Company / operator requisites (shown in footer, contacts, legal pages)
# VITE_COMPANY_LEGAL_NAME=ООО «Пример»
# VITE_COMPANY_SHORT_NAME=Stanki
# VITE_COMPANY_INN=0000000000
# VITE_COMPANY_KPP=000000000
# VITE_COMPANY_OGRN=0000000000000
# VITE_COMPANY_LEGAL_ADDRESS=г. Москва, …
# VITE_COMPANY_ADDRESS=г. Москва, …
# VITE_COMPANY_EMAIL=info@example.com
# VITE_COMPANY_PRIVACY_EMAIL=privacy@example.com
# VITE_COMPANY_PHONE=+7 (000) 000-00-00
# VITE_COMPANY_PHONE_HREF=tel:+70000000000
# VITE_COMPANY_DIRECTOR=Иванов И.И.
# VITE_COMPANY_BANK=р/с … в банке …, БИК …
